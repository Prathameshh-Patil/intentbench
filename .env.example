# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider src/intentbench/llm.py uses: gemini (default; all reported results) or groq.
LLM_PROVIDER=gemini

# Groq API key, only needed with LLM_PROVIDER=groq (model openai/gpt-oss-120b).
# Create one at https://console.groq.com (API Keys).
GROQ_API_KEY=

# Maximum Groq requests per minute. The free tier allows 30.
GROQ_RPM=30

# Google Gemini API key, used by src/intentbench/llm.py for the zero-shot and few-shot LLM
# classifier. Create one at https://aistudio.google.com (Get API key).
GEMINI_API_KEY=

# Maximum Gemini requests per minute. The free tier allows 15 for gemini-3.5-flash-lite;
# raise it if your key is on a paid plan.
GEMINI_RPM=15

# Demo only (demo/app.py): maximum fresh LLM calls per day, so visitors can't run up a bill.
LLM_DAILY_CAP=200

# Demo only: Hugging Face Hub repo to download the models from when models/ is empty.
INTENTBENCH_HF_REPO=Prathameshh-Patil/intentbench-distilbert

# API only (src/intentbench/serve): model folder or Hub repo id, and an optional override of the
# out-of-scope threshold chosen in reports/threshold.json.
INTENTBENCH_MODEL=
OOS_THRESHOLD=
