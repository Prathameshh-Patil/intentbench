# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider src/intentbench/llm.py uses: groq (default) or gemini.
LLM_PROVIDER=groq

# Groq API key for the LLM classifier (model openai/gpt-oss-120b).
# Create one at https://console.groq.com (API Keys).
GROQ_API_KEY=

# Maximum Groq requests per minute. The free tier allows 30.
GROQ_RPM=30

# Google Gemini API key, used by src/intentbench/llm.py for the zero-shot and few-shot LLM
# classifier. Create one at https://aistudio.google.com (Get API key).
GEMINI_API_KEY=

# Maximum Gemini requests per minute. The free tier allows 15 for gemini-3.5-flash-lite;
# raise it if your key is on a paid plan.
GEMINI_RPM=15
